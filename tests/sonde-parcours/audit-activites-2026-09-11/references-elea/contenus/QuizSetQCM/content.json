          },
          {
            "text": "Il faut que \\( x \\geq 0 \\).",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "Il faut que \\( x \\) soit un nombre décimal.",
            "correct": false,
