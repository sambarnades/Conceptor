{
  "name": "Proxy pour API Albert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "albert-proxy",
        "options": {}
      },
      "id": "3f9a9e3d-20a8-4e7a-9a3b-8e6b7e8c9d0f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://albert.api.etalab.gouv.fr/v1/chat/completions",
        "authentication": "headerAuth",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify($json[\"body\"]) }}",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
      "name": "Requête vers Albert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1260,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "albert-api-key",
          "name": "Clé API Albert"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "json": [
            {
              "name": "model",
              "value": "albert-small"
            },
            {
              "name": "messages",
              "value": "={{ [{ \"role\": \"user\", \"content\": $json.body.prompt }] }}"
            },
            {
              "name": "temperature",
              "value": 0.2
            },
            {
              "name": "max_tokens",
              "value": 4096
            }
          ]
        },
        "options": {}
      },
      "id": "5e8f7a6b-1c2d-3e4f-a9b8-c7d6e5f4a3b2",
      "name": "Préparer la requête",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2.1,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "responseData": "={{ JSON.parse($json.choices[0].message.content) }}"
        }
      },
      "id": "f0e9d8c7-b6a5-4321-fedc-ba9876543210",
      "name": "Répondre au Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1480,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Préparer la requête",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Préparer la requête": {
      "main": [
        [
          {
            "node": "Requête vers Albert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Requête vers Albert": {
      "main": [
        [
          {
            "node": "Répondre au Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}